      "bloc-affinity",
      "metis",
      "kahip",
      "kaminpar",
      "kaminpar-strong",
      "mtkahypar",
      "mtkahypar-quality"
    ]
  },
  "protocol": {
    "training": "leave-one-corpus-out",
    "oracle": "graph-level mean edge-cut across fixed solver seeds",
    "router": {
      "features": [
        "density",
