  "experiment": "k4-routing-generalization",
  "status": "completed",
  "question": "Does topology-based routing retain measurable transfer value when graph partitioning moves from k=2 to genuine k=4?",
  "scope": {
    "domain": "graph partitioning",
    "problem": "balanced unweighted k-way partitioning",
    "k": 4,
    "graphs": 20,
    "seeds": [42, 101, 2024],
    "strategies": [
