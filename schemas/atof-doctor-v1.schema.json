{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrishotza/Adaptiv-Topologica-Optimization-Framework/blob/main/schemas/atof-doctor-v1.schema.json",
  "title": "ATOF doctor report",
  "type": "object",
  "required": ["schema", "name", "version", "runtime", "backends", "input_formats", "portfolio_ready", "portfolio_kway_ready", "portfolio_kway_backends"],
  "properties": {
    "schema": {"const": "atof.doctor.v1"},
    "name": {"const": "atof"},
    "version": {"type": "string"},
    "runtime": {"type": "object"},
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "package", "optional", "available", "version", "importable", "import_error", "error"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "package": {"type": "string"},
          "optional": {"type": "boolean"},
          "available": {"type": "boolean"},
          "version": {"type": ["string", "null"]},
          "importable": {"type": "boolean"},
          "import_error": {"type": ["string", "null"]},
          "error": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "input_formats": {"type": "array", "items": {"type": "string"}},
    "portfolio_ready": {"type": "boolean"},
    "portfolio_kway_ready": {"type": "boolean"},
    "portfolio_kway_backends": {"type": "array", "items": {"type": "string"}}
  }
}
