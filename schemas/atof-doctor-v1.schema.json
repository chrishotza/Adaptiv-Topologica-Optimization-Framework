{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrishotza/Adaptiv-Topologica-Optimization-Framework/blob/main/schemas/atof-doctor-v1.schema.json",
  "title": "ATOF doctor report",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "runtime",
    "backends",
    "input_formats",
    "portfolio_ready"
  ],
  "properties": {
    "schema": {
      "const": "atof.doctor.v1"
    },
    "name": {
      "const": "atof"
    },
    "version": {
      "type": "string"
    },
    "runtime": {
      "type": "object"
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "package",
          "optional",
          "available",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "importable": {
            "type": "boolean"
          },
          "import_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "input_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "portfolio_ready": {
      "type": "boolean"
    },
    "portfolio_kway_ready": {
      "type": "boolean"
    },
    "portfolio_kway_backends": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "probe": {
      "type": "object",
      "required": [
        "requested",
        "ok",
        "error",
        "k2",
        "k4"
      ],
      "properties": {
        "requested": {
          "const": true
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "k2": {
          "type": "object",
          "required": [
            "ok",
            "error",
            "graph",
            "k",
            "seed",
            "iterations",
            "backends"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "graph": {
              "type": "object",
              "required": [
                "nodes",
                "edges"
              ],
              "properties": {
                "nodes": {
                  "type": "integer"
                },
                "edges": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "k": {
              "type": "integer"
            },
            "seed": {
              "type": "integer"
            },
            "iterations": {
              "type": "integer"
            },
            "backends": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "ok",
                  "edge_cut",
                  "balance_error",
                  "runtime_seconds",
                  "error"
                ],
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "edge_cut": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "balance_error": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "runtime_seconds": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "k4": {
          "type": "object",
          "required": [
            "ok",
            "error",
            "graph",
            "k",
            "seed",
            "iterations",
            "backends"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "graph": {
              "type": "object",
              "required": [
                "nodes",
                "edges"
              ],
              "properties": {
                "nodes": {
                  "type": "integer"
                },
                "edges": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "k": {
              "type": "integer"
            },
            "seed": {
              "type": "integer"
            },
            "iterations": {
              "type": "integer"
            },
            "backends": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "ok",
                  "edge_cut",
                  "balance_error",
                  "runtime_seconds",
                  "error"
                ],
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "edge_cut": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "balance_error": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "runtime_seconds": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
