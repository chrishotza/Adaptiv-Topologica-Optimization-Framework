{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrishotza/Adaptiv-Topologica-Optimization-Framework/blob/main/schemas/atof-ai-v1.schema.json",
  "title": "ATOF AI manifest",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "purpose",
    "primary_flow",
    "commands",
    "input",
    "capabilities",
    "output",
    "claim_policy",
    "limits"
  ],
  "properties": {
    "schema": {"const": "atof.ai.v1"},
    "name": {"const": "atof"},
    "version": {"type": "string"},
    "purpose": {"type": "string"},
    "primary_flow": {"type": "string"},
    "commands": {
      "type": "object",
      "required": [
        "ai",
        "doctor",
        "solve",
        "profile",
        "optimize",
        "version",
        "short_flags"
      ],
      "properties": {
        "ai": {"type": "string"},
        "doctor": {"type": "string"},
        "solve": {"type": "string"},
        "module": {"type": "string"},
        "profile": {"type": "string"},
        "optimize": {"type": "string"},
        "version": {"type": "string"},
        "short_flags": {
          "type": "object",
          "required": [
            "compact",
            "engine",
            "seed",
            "iterations",
            "format",
            "output",
            "partition_output",
            "full"
          ],
          "properties": {
            "compact": {"const": "-c"},
            "engine": {"const": "-e"},
            "seed": {"const": "-s"},
            "iterations": {"const": "-i"},
            "format": {"const": "-f"},
            "output": {"const": "-o"},
            "partition_output": {"const": "-p"},
            "full": {"const": "-F"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "formats",
        "default_format",
        "default_seed",
        "stdin",
        "json"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "items": {"type": "string"}
        },
        "default_format": {"const": "auto"},
        "default_seed": {"type": "integer"},
        "json": {
          "type": "object",
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": {"const": "optional array of node IDs"},
            "edges": {"const": "array of 2-item node-ID arrays"}
          },
          "additionalProperties": false
        },
        "stdin": {
          "type": "object",
          "required": ["path", "formats"],
          "properties": {
            "path": {"const": "-"},
            "formats": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "engine",
        "portfolio",
        "exports",
        "provenance"
      ],
      "properties": {
        "engine": {
          "type": "object",
          "required": [
            "k",
            "objective",
            "backend",
            "variants"
          ],
          "properties": {
            "k": {"const": ">=2"},
            "objective": {"type": "string"},
            "backend": {"const": "BLOC-RELOC"},
            "variants": {
              "type": "object",
              "required": [
                "baseline",
                "affinity",
                "auto"
              ],
              "properties": {
                "baseline": {"type": "string"},
                "affinity": {"type": "string"},
                "auto": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "portfolio": {
          "type": "object",
          "required": [
            "k",
            "objective",
            "backends",
            "selection"
          ],
          "properties": {
            "k": {"const": 2},
            "objective": {"type": "string"},
            "backends": {
              "type": "array",
              "items": {"type": "string"}
            },
            "selection": {"type": "string"}
          },
          "additionalProperties": false
        },
        "exports": {
          "type": "array",
          "items": {"type": "string"}
        },
        "provenance": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "default",
        "compact",
        "full",
        "objective_metric_rule"
      ],
      "properties": {
        "default": {"const": "JSON"},
        "compact": {"type": "string"},
        "full": {"type": "string"},
        "objective_metric_rule": {"type": "string"}
      },
      "additionalProperties": false
    },
    "claim_policy": {
      "type": "object",
      "required": ["rule", "non_claims"],
      "properties": {
        "rule": {"type": "string"},
        "non_claims": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
